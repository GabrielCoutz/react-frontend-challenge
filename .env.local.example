# TMDB API Read Access Token — get it at themoviedb.org/settings/api
VITE_TMDB_ACCESS_TOKEN=

VITE_TMDB_BASE_URL=
VITE_TMDB_IMAGE_BASE_URL=

# Secret for HMAC-SHA256 cookie signing — use a long random string in production
# Falls back to "dev-secret-change-in-prod" if not set (development only)
VITE_COOKIE_SIGNING_SECRET=